{
  "name": "front-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "stylelint": "stylelint \"**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky install",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "analyze": "ANALYZE=true npm run build",
    "commit": "./scripts/auto-commit.sh",
    "commit:skip-checks": "./scripts/auto-commit.sh --skip-checks",
    "commit:skip-tests": "./scripts/auto-commit.sh --skip-tests",
    "commit:help": "./scripts/auto-commit.sh --help",
    "pre-commit": "lint-staged",
    "commit-msg": "echo '提交信息验证通过'"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{css,scss}": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@types/dompurify": "^3.0.5",
    "@types/react-window": "^1.8.8",
    "antd": "5.27.4",
    "dayjs": "^1.11.18",
    "dompurify": "^3.3.0",
    "next": "15.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-window": "^2.2.1",
    "styled-components": "6.1.19",
    "web-vitals": "^5.1.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@next/bundle-analyzer": "^15.5.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "20.17.12",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@types/styled-components": "5.1.34",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.5.4",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "^16.2.4",
    "stylelint": "15.10.2",
    "stylelint-config-standard": "34.0.0",
    "typescript": "5.7.3"
  }
}
